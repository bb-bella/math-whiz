{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "GEMINI_API_KEY": "@GEMINI_API_KEY",
    "VITE_APP_ENV": "production"
  },
  "functions": {
    "api/*.ts": {
      "runtime": "@vercel/node@3.x"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
